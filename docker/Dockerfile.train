# Training image with CUDA support - use PyTorch base image
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget curl ca-certificates \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1-mesa-glx \
    ffmpeg libavcodec-extra \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel

# Copy project
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY configs/ ./configs/

# Install package with dev dependencies
RUN pip install -e ".[dev]"

# Install TensorRT (optional, for export)
# RUN pip install tensorrt --index-url https://pypi.ngc.nvidia.com

ENTRYPOINT ["python", "-m", "egoindustrial.training.train"]