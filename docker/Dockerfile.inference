# Inference image with TensorRT - use PyTorch base image with CUDA
FROM pytorch/pytorch:2.12.0-cuda12.6-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Install system dependencies (Ubuntu 24.04 noble)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget curl ca-certificates \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1 \
    ffmpeg libavcodec-extra \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel --break-system-packages

# Copy project
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY configs/ ./configs/

# Install package with inference dependencies
RUN pip install -e ".[inference]" --break-system-packages

# Install TensorRT Python bindings (optional - install at runtime on GPU server)
# RUN pip install tensorrt --index-url https://pypi.ngc.nvidia.com --break-system-packages

# Expose ports
EXPOSE 8000 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["python", "-m", "egoindustrial.inference.server"]
CMD ["--help"]